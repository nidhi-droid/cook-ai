generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  recipe    String
  createdAt DateTime @default(now())
}

model History {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  recipe    String
  createdAt DateTime @default(now())
}
